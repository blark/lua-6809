diff -ruN a/src/lmathlib.c b/src/lmathlib.c
--- a/src/lmathlib.c	2007-12-27 08:02:25
+++ b/src/lmathlib.c	2025-12-29 14:13:34
@@ -17,6 +17,19 @@
 #include "lualib.h"
 
 
+/* Integer power function for luai_numpow */
+int luai_ipow(int base, int exp) {
+  int result = 1;
+  if (exp < 0) return 0;
+  while (exp > 0) {
+    if (exp & 1) result *= base;
+    exp >>= 1;
+    base *= base;
+  }
+  return result;
+}
+
+
 #undef PI
 #define PI (3.14159265358979323846)
 #define RADIANS_PER_DEGREE (PI/180.0)
