--- a/Makefile.6809	2025-12-31 11:18:00.450827000 -0500
+++ b/Makefile.6809	2025-12-30 20:01:37.171700896 -0500
@@ -0,0 +1,24 @@
+# Makefile for Lua 5.1.5 on MC6809
+# Used by nix flake to build the VM
+
+CC ?= m6809-unknown-none-gcc
+CFLAGS += -DLUA_USE_6809 -DLUA_CORE -Os
+
+# Excluded: lparser, llex, lcode, ldump (stubs in lua6809.c for bytecode-only mode)
+SRCS = lapi.c ldebug.c ldo.c lfunc.c lgc.c lmem.c lobject.c lopcodes.c \
+       lstate.c lstring.c ltable.c ltm.c lundump.c lvm.c lzio.c lauxlib.c lua6809.c
+
+OBJS = $(SRCS:.c=.o)
+
+.PHONY: all clean
+
+all: lua.s19
+
+lua.s19: $(OBJS)
+	$(CC) $(LDFLAGS) -o $@ $(OBJS)
+
+%.o: %.c
+	$(CC) $(CFLAGS) -c $< -o $@
+
+clean:
+	rm -f $(OBJS) lua.s19
